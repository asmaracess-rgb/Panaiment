      "description": "Koleksi Bank Sampah Unit"
    },
    "/waste_logs/{logId}": {
      "schema": "#/entities/WasteLogEntry",
      "description": "Koleksi catatan timbangan sampah"
    },
    "/cleanup_events/{eventId}": {
