  "firestore": {
    "/user_profiles/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Profil pengguna terautentikasi dan peran pengguna (warga/admin)"
    },
    "/admins/{adminUid}": {
      "schema": "#/entities/AdminRoleRecord",
      "description": "Daftar tepercaya akun Administrator Kelurahan yang diotorisasi"
    },
    "/citizen_submissions/{submissionId}": {
      "schema": "#/entities/CitizenSubmission",
      "description": "Pengajuan layanan administrasi dan pengaduan milik warga terautentikasi"
    },
    "/kelurahan_profiles/{profileId}": {
      "schema": "#/entities/KelurahanProfile",
      "description": "Profil tunggal Kelurahan Panaikang"
    },
    "/rw_groups/{rwId}": {
