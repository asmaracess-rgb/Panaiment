{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pengguna terautentikasi (Warga atau Pejabat Admin) beserta peran yang dilindungi",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "nik": { "type": "string", "minLength": 0, "maxLength": 32 },
        "phone": { "type": "string", "minLength": 0, "maxLength": 32 },
        "rw": { "type": "string", "minLength": 2, "maxLength": 16 },
        "rt": { "type": "string", "minLength": 2, "maxLength": 16 },
        "address": { "type": "string", "minLength": 0, "maxLength": 300 },
        "role": { "type": "string", "enum": ["warga", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "rw", "rt", "role", "createdAt", "updatedAt"]
    },
    "AdminRoleRecord": {
      "title": "AdminRoleRecord",
      "description": "Dokumen sumber kebenaran tepercaya untuk akun Administrator Kelurahan di Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "nip": { "type": "string", "minLength": 0, "maxLength": 40 },
        "jabatan": { "type": "string", "minLength": 2, "maxLength": 120 },
        "unitBidang": { "type": "string", "minLength": 2, "maxLength": 120 },
        "roleLevel": { "type": "string", "enum": ["master_admin", "admin_bidang", "operator", "viewer"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "jabatan", "roleLevel", "isActive", "createdAt", "updatedAt"]
    },
    "CitizenSubmission": {
      "title": "CitizenSubmission",
      "description": "Pengajuan layanan administrasi surat atau laporan pengaduan milik warga terautentikasi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "ticketCode": { "type": "string", "minLength": 3, "maxLength": 64 },
        "submissionType": { "type": "string", "enum": ["layanan_administrasi", "pengaduan_lingkungan"] },
        "serviceCategoryId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "serviceName": { "type": "string", "minLength": 2, "maxLength": 160 },
        "title": { "type": "string", "minLength": 3, "maxLength": 200 },
        "description": { "type": "string", "minLength": 3, "maxLength": 2000 },
        "applicantName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "applicantNik": { "type": "string", "minLength": 0, "maxLength": 32 },
        "applicantPhone": { "type": "string", "minLength": 0, "maxLength": 32 },
        "rw": { "type": "string", "minLength": 2, "maxLength": 16 },
        "rt": { "type": "string", "minLength": 2, "maxLength": 16 },
        "address": { "type": "string", "minLength": 2, "maxLength": 300 },
        "status": { "type": "string", "enum": ["Menunggu Verifikasi", "Sedang Ditangani", "Selesai", "Ditolak"] },
        "responseNote": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "letterRegisterNumber": { "type": "string", "minLength": 0, "maxLength": 120 },
        "createdAtDisplay": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerId",
        "ownerEmail",
        "ticketCode",
        "submissionType",
        "serviceCategoryId",
        "serviceName",
        "title",
        "description",
        "applicantName",
        "applicantNik",
        "applicantPhone",
        "rw",
        "rt",
        "address",
        "status",
        "responseNote",
        "letterRegisterNumber",
        "createdAtDisplay",
        "createdAt",
        "updatedAt"
      ]
    },
    "KelurahanProfile": {
