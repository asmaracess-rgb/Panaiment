        "lurahPhotoUrl": { "type": "string", "minLength": 0, "maxLength": 400000 },
        "sekretarisName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "kasiKebersihanName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "kasiPemerintahanName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "officeAddress": { "type": "string", "minLength": 2, "maxLength": 300 },
        "subDistrict": { "type": "string", "minLength": 0, "maxLength": 80 },
        "city": { "type": "string", "minLength": 0, "maxLength": 80 },
        "postalCode": { "type": "string", "minLength": 0, "maxLength": 16 },
        "serviceHours": { "type": "string", "minLength": 0, "maxLength": 120 },
        "phoneContact": { "type": "string", "minLength": 0, "maxLength": 40 },
        "emailContact": { "type": "string", "minLength": 0, "maxLength": 120 },
        "areaKm2": { "type": "string", "minLength": 0, "maxLength": 32 },
        "totalRw": { "type": "number" },
        "totalRt": { "type": "number" },
        "totalPopulation": { "type": "string", "minLength": 0, "maxLength": 40 },
        "visi": { "type": "string", "minLength": 0, "maxLength": 1500 },
        "misi": { "type": "array" },
        "boundaries": { "type": "object" },
        "officials": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["lurahName", "lurahNip", "officeAddress", "visi", "misi"]
    },
    "RwGroup": {
